flowchart LR
    accTitle: FootyLevels system context
    accDescr: Players use the iOS app. The app signs in with Firebase, talks to the FootyLevels API through ngrok for records and jobs, and moves video bytes directly to and from Supabase. The DGX runs the API, workers and the 3D model runtime; Gemini writes lessons.
    player(["Player"]) --> app
    coachfriend(["Circle members: friends, teammates, coach"]) --> app
    subgraph phone ["iPhone"]
        app["FootyLevels iOS app: Learn, Overlay, Community, Videos"]
    end
    app -->|"sign in, ID tokens"| auth["Firebase Authentication"]
    app -->|"HTTPS JSON with Bearer token"| ngrok["ngrok public endpoint"]
    ngrok --> api["FootyLevels API on the DGX"]
    app <-->|"resumable upload and 5 minute signed reads"| sb[("Supabase private storage")]
    api -->|"verify tokens"| auth
    api <--> fs[("Firestore: records and job queue")]
    api -->|"mint upload and read capabilities"| sb
    api --> workers["DGX workers: media preparation, 3D reconstruction, lesson builder, deletion cleanup"]
    workers <--> fs
    workers <--> sb
    workers --> gpu["Model runtime: SAM 3 tracking and SAM 3D Body on one A100"]
    workers -->|"lesson authoring"| gemini["Google Gemini API"]
    bundled[["Bundled lessons and example clip inside the app"]] -.-> app
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef external fill:#fff4de,stroke:#a78336,color:#152b46;
    class fs,sb data;
    class auth,ngrok,gemini external;
