flowchart TB
    accTitle: Grounded multi-pass lesson authoring
    accDescr: Six steps. Gemini screens, the 3D pipeline measures, Gemini looks at player close-ups, teaches with measured placeholders and verifies claims; deterministic checks finish the lesson.
    video[/"Prepared video: 30 fps, max 720p, silent"/]
    video --> s1["1 Screen, Gemini: whole clip at 5 fps"]
    s1 -.->|"not football, no clear player, unclear"| reject(["Rejected before any GPU time"])
    s1 -->|"up to 4 moves with rough ranges"| s2["2 Reconstruct and measure, GPU: cuts, tracking with ball, 3D body, analysis"]
    s2 --> analysis[("analysis.json: touches, plants, turn, drop, ball; tracking.json boxes")]
    s2 --> s3["3 Look, Gemini, per move: player-cropped close-up, half speed, 10 fps, measured events as hints"]
    analysis -.-> s3
    s3 -->|"phases with start, end, key; ball foot from contacts; keys snapped within 0.2 s"| s4["4 Teach, Gemini: checked timeline and lesson schema"]
    analysis -.-> s4
    s4 -->|"cues, drills, challenges; numbers only as placeholders"| s5["5 Verify, Gemini, per move: each claim against its close-up"]
    s5 -->|"supported kept, unclear moved to unsure, unsupported removed"| s6["6 Deterministic checks: shots, keys, challenge top-up, strict validation"]
    analysis -.-> s6
    s6 --> build["Build: placeholders filled from measurements, app contract check"]
    build --> bundle[/"Lesson-id.bundle"/]
    cache[("Answer cache per job: video hash, prompt hash, model, step")] -.-> s3
    cache -.-> s5
    classDef model fill:#fff4de,stroke:#a78336,color:#152b46;
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    class s1,s3,s4,s5 model;
    class analysis,bundle,cache data;
