flowchart TB
    accTitle: FootyLevels deployment
    accDescr: One DGX runs the API with its child workers, the private model runtime and the ngrok agent under systemd user services. Firebase and Supabase are separate per environment; Gemini is called only by the GPU runner.
    phone["iPhone app"] -->|"HTTPS"| endpoint["ngrok public endpoint"]
    subgraph dgx ["DGX host, user services"]
        tunnel["ngrok agent"]
        api["API: uvicorn api.cloud on 127.0.0.1:8010"]
        cpu["CPU worker: run_media_worker.py"]
        gpuRunner["GPU runner: run_reconstruction_worker.py, reconstructions and lessons"]
        runtime["Model runtime on 127.0.0.1:8013 with inference.sock"]
        a100["One A100, serial model work"]
        local[("Weights, staging folders, replay and lesson caches")]
        systemd["systemd user target and 1 minute health timer"]
    end
    endpoint --> tunnel --> api
    api -->|"starts and supervises"| cpu
    api -->|"starts and supervises"| gpuRunner
    gpuRunner -->|"credential-free adapters over the Unix socket"| runtime
    runtime --> a100
    runtime --> local
    systemd -.-> api
    systemd -.-> runtime
    systemd -.-> tunnel
    subgraph dev ["Development cloud"]
        devAuth["Firebase Auth and Firestore: footylevels-dev"]
        devStore[("Supabase: private-media, reference-assets")]
    end
    subgraph demo ["Demo cloud, foundation only"]
        demoAuth["Firebase Auth and Firestore: footylevels-demo"]
        demoStore[("Supabase buckets")]
    end
    api --> devAuth
    api --> devStore
    cpu --> devStore
    gpuRunner --> devStore
    gpuRunner -->|"HTTPS"| gemini["Gemini API"]
    phone --> devAuth
    phone --> devStore
    style demo fill:#f8fafc,stroke:#a5b4c8,stroke-dasharray:5 5
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    class devStore,demoStore,local data;
