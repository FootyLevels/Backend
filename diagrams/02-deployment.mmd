flowchart TB
    accTitle: FootyLevels Development deployment and trust boundaries
    accDescr: ngrok exposes only the authenticated loopback API. CPU workers hold cloud access; the private GPU runtime uses a user-only Unix socket. Demo has isolated cloud resources but no active API runtime.
    subgraph phone ["Client device"]
        app["SwiftUI app and RealityKit player"]
    end
    subgraph edge ["Public HTTPS"]
        endpoint["Approved ngrok endpoint"]
    end
    subgraph dgx ["Sheridan DGX: 142.55.34.202, account bajajkun"]
        subgraph network ["Application-scoped DNS namespaces"]
            tunnel["ngrok agent"]
            api["Authenticated API: 127.0.0.1:8010"]
            cpu["One CPU media and cleanup worker"]
            gpuWorker["One reconstruction dispatcher"]
            model["Owned model process: 127.0.0.1:8013"]
        end
        bridge["Private inference.sock: directory 0700, socket 0600"]
        gpu["One selected A100: serial model work"]
        files[("Private weights, cache and staging on DGX")]
        supervisor["systemd user services and local health timer"]
    end
    subgraph cloud ["Development cloud resources: free plans"]
        auth["Firebase Authentication"]
        db[("Firestore: records, jobs and cleanup intents")]
        storage[("Supabase: private-media and reference-assets")]
    end
    subgraph demo ["Demo foundation: configured, runtime pending"]
        demoFirebase["Separate Firebase Auth and Firestore"]
        demoStorage["Separate Supabase private buckets"]
    end
    app -->|"ID-token API requests"| endpoint
    endpoint -->|"Agent connection"| tunnel
    tunnel -->|"Localhost Host rewrite"| api
    app -->|"Login"| auth
    app -->|"Scoped file capabilities"| storage
    api -->|"Verify identity"| auth
    api -->|"Own and supervise child processes"| cpu
    api -->|"Own and supervise child processes"| gpuWorker
    api -->|"Scoped server access"| db
    api -->|"Verify and sign assets"| storage
    cpu -->|"Claim and publish prepared media"| db
    gpuWorker -->|"Claim and publish reconstruction"| db
    cpu -->|"Read and write private files"| storage
    gpuWorker -->|"Read and write private files"| storage
    gpuWorker -->|"Credential-free adapter"| bridge
    bridge -->|"Private IPC"| model
    model -->|"Load and execute"| gpu
    model -->|"Weights and bounded local cache"| files
    supervisor -.->|"Restart and local readiness"| api
    supervisor -.->|"Restart and warmup"| model
    supervisor -.->|"Restart agent"| tunnel
