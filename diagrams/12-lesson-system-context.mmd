flowchart LR
    accTitle: Lessons from your own video, system context
    accDescr: The app asks the API for a lesson; the GPU runner on the DGX screens the video with Gemini, reconstructs 3D motion with ball tracking, writes and checks the lesson, and publishes a private bundle the app downloads directly from Supabase.
    learner(["Learner"]) --> app["iOS app: Videos tab and Learn tab"]
    app -->|"metadata and job status over HTTPS"| ngrok["ngrok public endpoint"]
    ngrok --> api["Application API on DGX 8010: api.cloud and api.lessons"]
    api --> fs[("Firestore: users, projects, jobs, lessons, lessonReports, lessonQuota")]
    app -->|"Firebase ID token"| auth["Firebase Authentication"]
    api --> auth
    app <-->|"TUS upload and signed reads"| sb[("Supabase private-media bucket")]
    subgraph dgx ["DGX, account bajajkun"]
        api
        runner["GPU runner parent: run_reconstruction_worker.py and lesson_worker.py"]
        child["Credential-free child: lesson_adapter.py"]
        runtime["Model runtime on 8013: SAM 3 tracking and SAM 3D Body"]
    end
    runner -->|"claim, heartbeat, fenced publish"| fs
    runner <-->|"prepared video in, lesson bundle out"| sb
    runner -->|"screen, look, teach, verify"| gemini["Gemini API: gemini-4-carbon"]
    runner -->|"empty environment"| child
    child -->|"inference.sock, profile lesson-motion-v1"| runtime
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef external fill:#fff4de,stroke:#a78336,color:#152b46;
    class fs,sb data;
    class gemini,auth,ngrok external;
