erDiagram
    accTitle: Firestore documents for lessons
    accDescr: New lesson, lessonReports and lessonQuota documents, and new optional fields on users, projects and jobs. File bytes stay in Supabase; artifacts are AssetRefs.
    users ||--o{ projects : owns
    users ||--o{ lessonQuota : "daily counter"
    projects ||--o{ jobs : schedules
    jobs ||--o| lessons : publishes
    projects ||--o{ lessons : retains
    lessons ||--o{ lessonReports : receives
    jobs ||--o{ assetReservations : budgets
    users {
        string id PK "Firebase UID"
        string displayName
        string accountState
        timestamp lessonAiConsentAt "NEW, set once accepted"
        string lessonAiConsentVersion "NEW, lesson-ai-v1"
    }
    projects {
        string id PK
        string ownerId FK
        string state "ready required"
        int inputRevision
        map preparedMedia "30 fps, max 720p, silent; source of the lesson"
        string activeJobId FK
        string latestLessonId FK "NEW"
    }
    jobs {
        string id PK "sha256 of uid, buildLesson, Idempotency-Key"
        string ownerId FK
        string projectId FK
        string kind "NEW value buildLesson"
        string profileVersion "lesson-3d-v1"
        string inputHash "sha256 of profile, motion profile, source, model"
        map sourceAsset "prepared media AssetRef"
        string status
        string stage "screeningVideo to publishingAssets"
        int attemptCount
        string errorCode "NEW lesson_unavailable, lesson_rejected"
        string lessonId FK "NEW"
    }
    lessons {
        string id PK "equals job id"
        string ownerId FK
        string projectId FK
        string jobId FK
        int inputRevision
        string profileVersion "lesson-3d-v1"
        map sourceAsset
        string title
        array skills "id and name, 1 to 8"
        map authoring "model, mode, promptSha256, claimsRemoved, calls"
        map engine "model, upstream commit, checkpoint and config hashes"
        array artifacts "4 to 64 AssetRefs under the lesson prefix"
        bool aiGenerated "always true"
        string state "ready or deleted"
        timestamp completedAt
    }
    lessonReports {
        string id PK "sha256 of uid, lesson, reason"
        string ownerId FK
        string lessonId FK
        string projectId FK
        string reason "wrong_move, wrong_timing, unsafe, inaccurate, other"
        string note "optional, max 500"
    }
    lessonQuota {
        string id PK "uid-YYYYMMDD"
        string ownerId FK
        string day
        int count "LESSON_DAILY_LIMIT default 3"
        timestamp expiresAt
    }
    assetReservations {
        string id PK "sha256 of object key"
        string jobId FK
        map asset
        int bytes
    }
