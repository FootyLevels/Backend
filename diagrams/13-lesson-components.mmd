flowchart TB
    accTitle: Lesson feature component architecture
    accDescr: App modules call new API routes; the lesson repository admits jobs transactionally; the GPU runner dispatches buildLesson claims to the lesson worker, which uses the lesson_pipeline library and a credential-free adapter that talks to the motion bridge.
    subgraph ios ["iOS app"]
        status["CloudProjectStatusView: Create lesson panel"]
        vm["CloudLessonViewModel: consent, create, poll, download"]
        client["CloudLessonClient on AuthenticatedAPIClient"]
        store["UserLessonStore: Caches/UserLessons/uid/Lesson-id.bundle"]
        library["LessonLibraryView and UserLessonsSection"]
        player["PackageLessonView and PackageLessonModel, unchanged"]
        status --> vm --> client
        vm --> store
        library --> store
        store --> player
    end
    subgraph apiLayer ["API process"]
        routes["api/lessons.py: lesson_router"]
        admit["lessons.py: FirestoreLessons.admit and enqueue_lesson"]
        rec["records.py: LessonRecord, LessonReport, JobRecord buildLesson"]
        del["deletions.py: lessons, reports and quota cascade"]
        routes --> admit --> rec
    end
    client --> routes
    subgraph gpu ["GPU runner process"]
        dispatch["run_reconstruction_worker.py: routes buildLesson claims"]
        ljobs["lesson_jobs.py: FirestoreLessonJobs claim and publish_lesson"]
        worker["lesson_worker.py: run_job stages"]
        dispatch --> ljobs
        dispatch --> worker
        worker --> ljobs
    end
    subgraph pipeline ["lesson_pipeline library"]
        session["generation.Session: upload, repair, audit, cache"]
        passes["passes.py: screen, look, teach, verify"]
        clips["clips.py: player close-ups at half speed"]
        grounded["grounded.py: author and deterministic checks"]
        analysis["analysis.py, cuts.py, measures.py"]
        build["build.py: build_app"]
        contract["app_contract.py: mirror of LessonPackage.check"]
        grounded --> passes --> session
        grounded --> clips
        grounded --> analysis
        build --> contract
    end
    worker --> grounded
    worker --> build
    worker --> adapter["infra/dgx/lesson_adapter.py: empty environment"]
    adapter --> analysis
    adapter --> bridge["motion_bridge.py: lesson-motion-v1 profile"]
    bridge --> models["SAM 3 segment_video and SAM 3D Body reconstruct_motion"]
    session --> gemini["Gemini API"]
    classDef isolated fill:#fff4de,stroke:#a78336,color:#152b46;
    classDef reused fill:#e8f6f1,stroke:#377967,color:#152b46;
    class adapter,bridge isolated;
    class player reused;
