flowchart LR
    accTitle: Lesson credentials, isolation and storage layout
    accDescr: Which process holds which secret, what crosses each boundary, where lesson files are stored and how the app verifies them.
    subgraph parent ["GPU runner parent: holds Firestore service account, Supabase secret, GEMINI_API_KEY"]
        lw["lesson_worker.run_job"]
        cache[("lesson-cache/jobId: accepted model answers, kept 7 days")]
    end
    subgraph childbox ["Adapter child: empty environment, PATH and HOME only"]
        la["lesson_adapter.py"]
    end
    subgraph rt ["Model runtime: no cloud keys"]
        mb["motion_bridge.py: accepts only lesson-NNNNNNNN/lesson-input.mp4"]
    end
    lw -->|"job.json without lease token, input.mp4"| la
    la -->|"Unix socket request with sha256"| mb
    mb -->|"motion files listed with sha256"| la
    la -->|"work/analysis, result.json"| lw
    lw --> cache
    lw -->|"video upload to Files API, deleted after the run"| gem["Gemini API"]
    lw -->|"put_file after reserve_outputs"| lessonfiles
    subgraph bucket ["Supabase private-media"]
        media["users/uid/projects/pid/media/jobId/attempt/: prepared video"]
        lessonfiles["users/uid/projects/pid/lesson/jobId/attempt/: lesson.json, analysis.json, mesh.json, video.mp4, motion/"]
    end
    media -->|"download_file"| lw
    api["API: signs 5 minute read URLs only for the owner"] --> lessonfiles
    app["iOS app"] -->|"POST /api/lessons/id/assets"| api
    lessonfiles -->|"signed GET"| app
    app --> verify["Check sha256 and size, LessonPackage.load, then move into Caches"]
    classDef secret fill:#fde8e8,stroke:#a33a3a,color:#152b46;
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    class lw secret;
    class media,lessonfiles,cache data;
