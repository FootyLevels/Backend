flowchart LR
    accTitle: FootyLevels API surface and access checks
    accDescr: Application data routes pass Firebase verification and profile access checks. Progress and account-data cleanup retain verified identity access after profile restriction. Public health has no authentication requirement.
    request["HTTPS request via ngrok"] --> publicRoute["GET /api/health"]
    request --> identity["Verify Firebase signature, audience, expiry and account status"]
    identity --> bootstrap["POST /api/me/bootstrap"]
    identity --> profileGate["Require active application profile"]
    profileGate --> me["GET /api/me"]
    profileGate --> projects["POST and GET /api/projects; GET, PATCH and DELETE project by ID"]
    profileGate --> uploads["Create upload session; read, refresh, finalize or cancel upload"]
    profileGate --> model["POST project reconstructions: keyframes or motion"]
    profileGate --> status["GET job; POST job cancel; GET reconstruction"]
    profileGate --> assets["POST project source or media assets; POST reconstruction assets"]
    profileGate --> comparison["GET comparison by ID"]
    identity --> removal["GET /api/deletions and progress; DELETE /api/me/data"]
    projects --> owner["Derive UID from token; enforce owner and tombstone fences"]
    uploads --> owner
    model --> owner
    status --> owner
    assets --> owner
    comparison --> owner
    removal --> owner
    owner --> response["Private response: no-store; foreign and missing data return 404"]
    classDef public fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef fence fill:#fff4de,stroke:#a78336,color:#152b46;
    class publicRoute public;
    class identity,profileGate,owner fence;
