flowchart TB
    accTitle: FootyLevels Backend component architecture
    accDescr: One application codebase separates authenticated routes and cloud repositories from credential-free media decoders and model adapters. The model runtime has one serial executor.
    client["Authenticated iOS request"] --> routes["api.cloud and api.assets"]
    routes --> identity["authentication.py: Firebase verifier"]
    routes --> records["repositories.py: profiles, projects, enqueue and owned reads"]
    routes --> uploads["uploads.py: source sessions and byte reservations"]
    jobs["reconstruction_jobs.py: claims, heartbeats and publication"]
    routes --> deletions["deletions.py: tombstones and durable cleanup"]
    routes --> assets["assets.py: private Supabase adapter"]
    records --> db[("Firestore")]
    uploads --> db
    jobs --> db
    deletions --> db
    subgraph background ["API-owned background processes"]
        cpu["run_media_worker.py"]
        media["media_jobs.py and media_worker.py"]
        maintenance["Bounded retention and deletion reconciliation"]
        dispatcher["run_reconstruction_worker.py"]
        publication["reconstruction_worker.py: source verification and publication"]
    end
    cpu --> media
    cpu --> maintenance
    media --> db
    maintenance --> deletions
    dispatcher --> publication
    publication --> jobs
    media --> assets
    publication --> assets
    assets --> storage[("Supabase private files")]
    media --> decoder["Credential-free FFprobe and FFmpeg groups"]
    publication --> adapter["Credential-free reconstruction_adapter.py"]
    subgraph privateRuntime ["Separate owned model service"]
        bridge["model_bridge.py and motion_bridge.py: owner-only Unix IPC"]
        serial["Shared serial executor"]
        body["Warm SAM 3D Body: selected keyframes"]
        motion["Sequential tracking and body stages: bounded motion"]
    end
    adapter --> bridge
    bridge --> serial
    serial --> body
    serial --> motion
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef isolated fill:#fff4de,stroke:#a78336,color:#152b46;
    class db,storage data;
    class decoder,adapter,bridge isolated;
