flowchart TB
    accTitle: Backend components
    accDescr: One FastAPI codebase. Routers per feature share identity and repositories; background processes share the job and storage layers; model work runs in credential-free children and a separate runtime.
    req["Authenticated request"] --> apiproc
    subgraph apiproc ["API process"]
        direction TB
        routers["Routers: api/cloud.py, api/assets.py, api/circles.py, api/lessons.py"]
        authn["authentication.py: Firebase verifier"]
        domain["Domain repositories: repositories.py, uploads.py, circles.py, lessons.py, deletions.py"]
        recs["records.py: validated document models"]
        routers --> authn
        routers --> domain
        domain --> recs
    end
    subgraph bg ["Background processes started by the API"]
        direction TB
        cpuW["CPU worker: media_worker.py and deletion reconciliation"]
        gpuW["GPU runner: reconstruction_worker.py and lesson_worker.py"]
        jobsL["Job stores: media_jobs, reconstruction_jobs, lesson_jobs: claims, leases, fenced publish"]
        lib["lesson_pipeline library"]
        cpuW --> jobsL
        gpuW --> jobsL
        gpuW --> lib
    end
    subgraph isolated ["Credential-free children"]
        direction LR
        ff["FFprobe and FFmpeg"]
        radapter["reconstruction_adapter.py"]
        ladapter["lesson_adapter.py"]
    end
    cpuW --> ff
    gpuW --> radapter
    gpuW --> ladapter
    radapter --> runtime["Model runtime: model_bridge.py and motion_bridge.py"]
    ladapter --> runtime
    apiproc --> fs[("Firestore")]
    bg --> fs
    apiproc --> sb[("Supabase")]
    bg --> sb
    gpuW --> gemini["Gemini API"]
    classDef isolatedc fill:#fff4de,stroke:#a78336,color:#152b46;
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    class ff,radapter,ladapter,runtime isolatedc;
    class fs,sb data;
