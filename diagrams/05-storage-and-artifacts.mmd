flowchart TB
    accTitle: FootyLevels file assets and storage accounting
    accDescr: Firestore stores references and reserved-byte ledgers. Supabase private-media stores uploaded video, prepared media, keyframe meshes and compressed motion. DGX weights and temporary work remain local.
    subgraph metadata ["Firestore: metadata only"]
        assetRef["AssetRef: bucket, objectKey, SHA-256, byteSize, contentType"]
        uploadRecord["uploads: source reservation and expiry"]
        outputRecord["assetReservations: generated-object accounting"]
        usage["storageUsage: global and per-owner byte ledgers"]
    end
    subgraph storage ["Supabase private-media bucket"]
        source["source/uploadId/video: verified original recording"]
        media["media/jobId/attempt: video.mp4 and six JPEG previews"]
        poses["reconstruction/jobId/attempt: keyframes.json and successful GLBs"]
        motion["reconstruction/jobId/attempt: sequence.json, faces.bin, gzip body chunks, video and six previews"]
    end
    curated["Supabase reference-assets: curated licensed references"]
    subgraph local ["DGX local private storage"]
        weights["Model weights and pinned upstream code"]
        staging["Disposable media and reconstruction workspaces"]
        cache["Bounded private inference replay caches"]
    end
    assetRef -->|"Verified immutable references"| source
    assetRef -->|"Verified immutable references"| media
    assetRef -->|"Verified immutable references"| poses
    assetRef -->|"Verified immutable references"| motion
    assetRef -->|"Versioned curator references"| curated
    uploadRecord -->|"Reserve before transfer"| usage
    outputRecord -->|"Reserve before generated-file writes"| usage
    staging -->|"Verified upload, then fenced publication"| storageWorker["CPU and reconstruction workers"]
    storageWorker --> media
    storageWorker --> poses
    storageWorker --> motion
    weights --> inference["Owned model inference"]
    inference --> cache
    access["API: owner validation and five-minute read map"] --> assetRef
    client["iOS: allowlisted downloads and checksum validation"] --> access
    client -->|"Temporary signed reads"| source
    client -->|"Temporary signed reads"| media
    client -->|"Temporary signed reads"| poses
    client -->|"Temporary signed reads"| motion
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef local fill:#fff4de,stroke:#a78336,color:#152b46;
    class assetRef,uploadRecord,outputRecord,usage,source,media,poses,motion,curated data;
    class weights,staging,cache local;
