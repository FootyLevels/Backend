flowchart TB
    accTitle: Grounded multi-pass lesson authoring data flow
    accDescr: Six steps. Gemini screens the clip, the 3D pipeline measures it, Gemini looks closely at player crops, teaches with measured placeholders, and verifies claims; deterministic checks finish the lesson.
    video[/"Prepared video: 30 fps, max 720p, silent"/]
    video --> s1["1 Screen, Gemini: whole clip at 5 fps"]
    s1 -.->|"not_football, no_clear_player, unclear"| reject(["Rejected before any GPU time"])
    s1 -->|"up to 4 moves with rough ranges"| s2["2 Reconstruct and measure, GPU: cuts, SAM 3 tracking with ball, SAM 3D Body, analysis.analyze"]
    s2 --> analysis[("analysis.json: touches, plants, turn, drop, ball; tracking.json boxes")]
    s2 --> s3["3 Look, Gemini, per move: player-cropped close-up, half speed, 10 fps, measured events as fallible hints"]
    analysis -.-> s3
    s3 -->|"phases with start, end, key; ball foot from contacts; keys snapped within 0.2 s"| s4["4 Teach, Gemini: checked timeline and lesson schema"]
    analysis -.-> s4
    s4 -->|"cues, drills, challenges; every number written as a placeholder such as touches A B ball"| s5["5 Verify, Gemini, per move: each claim against its close-up"]
    s5 -->|"supported kept, unclear moved to unsure, unsupported removed"| s6["6 Deterministic checks: shots from analysis, keys snapped, challenges topped up, validate strict"]
    analysis -.-> s6
    s6 --> build["build_app: placeholders resolved from measurements, app_contract.check_bundle"]
    build --> bundle[/"Lesson-id.bundle: lesson.json, analysis.json, mesh.json, video.mp4, motion/"/]
    cache[("Authoring cache per job, key: videoSha256, promptSha256, model, step")] -.-> s3
    cache -.-> s5
    classDef model fill:#fff4de,stroke:#a78336,color:#152b46;
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    class s1,s3,s4,s5 model;
    class analysis,bundle,cache data;
