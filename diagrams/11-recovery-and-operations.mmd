flowchart LR
    accTitle: FootyLevels service recovery and durable work recovery
    accDescr: Enabled user services configure startup without SSH login and recover separate API, model and tunnel processes. Firestore leases and attempt fences recover jobs independently of process liveness.
    startup["User lingering and enabled footylevels.target"] --> manager["systemd user manager"]
    manager --> api["API service: restart after 15 seconds"]
    manager --> model["Model service: retry after 60 seconds"]
    manager --> tunnel["Tunnel service: restart after 30 seconds"]
    manager --> timer["Health timer: once per minute"]
    api --> children["One CPU worker and one reconstruction dispatcher"]
    children --> workerExit["Child exits: API supervisor stops deployment"]
    workerExit --> group["Stop old service cgroup; reap owned descendants"]
    group --> manager
    model --> preflight["Pinned weights, one A100 UUID and at least 12 GiB free headroom"]
    preflight -->|"Pass"| warm["Warm model and private bridge ready"]
    preflight -->|"Insufficient capacity or invalid runtime"| manager
    timer --> snapshot["Private health.json: service states and local readiness"]
    children --> db[("Firestore jobs, leases and immutable attempts")]
    db --> reclaim["Reclaim eligible expired work with fresh lease and bounded attempts"]
    reclaim --> children
    db --> publish["Publication transaction rejects stale, cancelled or deleted work"]
    ops["Operator: pause intake, drain work, change immutable release link"] --> manager
    ops --> verify["Readiness and public auth smoke; restore previous link if needed"]
    classDef data fill:#e8f6f1,stroke:#377967,color:#152b46;
    classDef control fill:#fff4de,stroke:#a78336,color:#152b46;
    class db,snapshot data;
    class manager,preflight,publish,group control;
