{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson (version 1)",
  "description": "A lesson.json as an author writes it, before the build fills in the placeholders. The fields marked required are the ones the app needs to open the lesson. `python -m lesson_pipeline check` enforces this plus the timing rules in SPEC.md.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "subtitle", "video", "sourceNote", "shots", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug", "description": "Also names the app bundle: Lesson-<id>.bundle." },
    "folder": { "$ref": "#/$defs/slug", "description": "Web output folder; defaults to the id." },
    "title": { "type": "string", "minLength": 1, "description": "2–4 words, a name not a sentence." },
    "accent": { "type": "string", "description": "A word of the title drawn in orange." },
    "subtitle": { "type": "string", "minLength": 1 },
    "video": { "const": "video.mp4" },
    "videoLabel": { "type": "string" },
    "sourceNote": { "type": "string", "minLength": 1, "description": "Completes 'Built from …'; credits the video." },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "label"],
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number" },
          "label": { "type": "string", "minLength": 1 },
          "quality": { "enum": ["low"] }
        }
      }
    },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skill" } },
    "notes": {
      "type": "object",
      "properties": {
        "limits": { "$ref": "#/$defs/strings" },
        "tests": { "$ref": "#/$defs/strings" },
        "choices": { "$ref": "#/$defs/strings" }
      }
    },
    "siblings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "self": { "type": "boolean" } }
      }
    },
    "draft": { "type": "boolean", "description": "Set by the automatic draft; remove it when the lesson is finished." },
    "reviewNotes": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "placeholder": { "type": "string", "pattern": "^\\{\\{\\s*[A-Za-z]+(\\s+[^{}\\s]+)*\\s*\\}\\}$" },
    "time": {
      "description": "Seconds into the video, or a lone placeholder such as {{firstTouch 4.9 5.2 ball}}.",
      "oneOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/placeholder" }]
    },
    "span": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/time" }, { "$ref": "#/$defs/time" }], "minItems": 2, "maxItems": 2 },
    "clip": {
      "description": "[start, end, rate]: a clip of this video and its playback rate.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/time" }, { "$ref": "#/$defs/time" }, { "type": "number", "minimum": 0.1, "maximum": 2, "description": "usually 0.25, 0.5 or 1" }],
      "minItems": 3,
      "maxItems": 3
    },
    "skill": {
      "type": "object",
      "required": ["id", "name", "short", "tab", "ballFoot", "range", "watch", "intro", "phases", "drills"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 },
        "tab": { "type": "string", "minLength": 1, "description": "Small label above the skill, e.g. 'Skill 1 · named', 'Level 3'." },
        "ballFoot": { "enum": ["left", "right"], "description": "The measured foot that works the ball. Text never names sides." },
        "ballLeavesGround": { "type": "boolean", "description": "false for ground moves: the ball stays on the turf." },
        "range": { "$ref": "#/$defs/span" },
        "watch": { "$ref": "#/$defs/span" },
        "watchTitle": { "type": "string" },
        "intro": { "type": "string", "minLength": 1 },
        "notice": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "title", "text"],
            "properties": { "t": { "$ref": "#/$defs/time" }, "title": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
          }
        },
        "adds": { "type": "string" },
        "unsure": { "$ref": "#/$defs/strings" },
        "breakdownIntro": { "type": "string" },
        "phases": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/phase" } },
        "drills": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/drill" } },
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/challenge" } }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "start", "end", "key", "cue"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "key": { "$ref": "#/$defs/time", "description": "The frame the lesson freezes on: the clearest moment of the phase." },
        "cue": { "type": "string", "minLength": 1, "description": "Short imperative coaching cue, ≤ 10 words." },
        "video": { "type": "string" },
        "shows": { "type": "string", "description": "What the 3D measured; numbers only as placeholders." },
        "conf": { "enum": ["high", "medium", "low"] },
        "why": { "type": "string" },
        "ov": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prints": { "type": "boolean" },
            "paths": { "type": "boolean" },
            "ghost": { "type": "boolean" },
            "arrow": { "type": "boolean" },
            "follow": { "type": "boolean" }
          }
        },
        "focus": { "enum": ["weight", "stand", "ball", "turn", "balls", "drop"] },
        "view": { "enum": ["video", "side", "behind", "top"] },
        "turn": { "type": "boolean" }
      }
    },
    "drill": {
      "type": "object",
      "required": ["id", "title", "lvl", "reps", "how", "model", "checks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "lvl": { "type": "string", "minLength": 1, "description": "e.g. 'Ball · walking pace'." },
        "reps": { "type": "integer", "minimum": 1, "maximum": 50 },
        "how": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/clip" },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "challenge": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "choice" },
            "t": { "$ref": "#/$defs/time" },
            "title": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
            "answer": { "type": "integer", "minimum": 0 },
            "explain": { "type": "string", "minLength": 1 },
            "play": { "$ref": "#/$defs/clip" },
            "view": { "enum": ["video", "side", "behind", "top"] }
          },
          "required": ["type", "t", "title", "prompt", "options", "answer", "explain"]
        },
        {
          "properties": {
            "type": { "const": "tap" },
            "from": { "$ref": "#/$defs/time" },
            "target": { "$ref": "#/$defs/time" },
            "label": { "type": "string", "minLength": 1 },
            "rate": { "type": "number", "minimum": 0.1, "maximum": 2 },
            "tolerance": { "type": "number", "exclusiveMinimum": 0 },
            "title": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "explain": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "from", "target", "label", "title", "prompt", "explain"]
        },
        {
          "properties": {
            "type": { "const": "order" },
            "title": { "type": "string" },
            "prompt": { "type": "string" },
            "ids": { "type": "array", "minItems": 3, "items": { "type": "string" } },
            "shuffled": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type", "ids"]
        }
      ]
    }
  }
}
